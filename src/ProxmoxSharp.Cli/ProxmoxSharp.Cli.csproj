<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Installable as a dotnet global tool: `dotnet tool install -g ProxmoxSharp.Cli`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>proxmoxsharp</ToolCommandName>
    <PackageId>ProxmoxSharp.Cli</PackageId>
    <!-- Co-versioned with the library (SemVer); CI appends -preview.N. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>CLI for ProxmoxSharp — read and discover Proxmox VE from the shell.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ProxmoxSharp/ProxmoxSharp.csproj" />
  </ItemGroup>

</Project>
