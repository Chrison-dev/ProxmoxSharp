<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- ProxmoxSharp packages are published here. Reading requires auth (a PAT
         with read:packages); the publish workflow pushes with GITHUB_TOKEN. -->
    <add key="github" value="https://nuget.pkg.github.com/Chrison-dev/index.json" />
  </packageSources>
</configuration>
