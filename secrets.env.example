# ProxmoxSharp dev secrets — copy to `secrets.env` (gitignored via *.env) and fill in.
# Use a DEDICATED, READ-ONLY API token (role e.g. PVEAuditor), not root creds.
# Create one in: Datacenter → Permissions → API Tokens (or `pveum user token add`).

# Use a node IP (HttpClient resolves via DNS, not your SSH config aliases):
PROXMOX_BASE_URL=https://192.168.179.3:8006/api2/json

# Token id is <user@realm>!<tokenid>:
PROXMOX_TOKEN_ID=root@pam!proxmoxsharp-dev

# The secret (UUID) shown once when the token was created:
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# PVE nodes use self-signed certs by default; set false for dev:
PROXMOX_VERIFY_TLS=false
